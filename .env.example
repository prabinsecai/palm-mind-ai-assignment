APP_NAME=Palm Mind AI Hiring Assignment
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=palm_mind
POSTGRES_USER=palm_mind
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://palm_mind:change-me@postgres:5432/palm_mind

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=palm_mind_documents

OPENAI_API_KEY=
# Optional; omit to use the official OpenAI endpoint.
# OPENAI_BASE_URL=https://your-openai-compatible-provider.example/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHAT_MEMORY_TTL_SECONDS=86400
MAX_UPLOAD_BYTES=10485760
